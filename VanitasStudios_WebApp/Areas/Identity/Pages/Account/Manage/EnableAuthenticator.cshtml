@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Configurazione Sicurezza 2FA";
    Layout = "/Pages/Shared/_Layout.cshtml"; // Forza l'uso del layout globale di Vanitas
}

<div class="manage-account-wrapper">
    <aside class="manage-sidebar">
        <div class="sidebar-brand-ctx">// CONFIGURAZIONE</div>
        <h2 class="sidebar-ctx-title">Account</h2>
        <partial name="_ManageNav" />
    </aside>

    <main class="manage-content-core">
        <div class="manage-header">
            <h1 class="manage-core-title">Autenticazione Doppia</h1>
            <p class="manage-subtitle">Proteggi l'accesso al portale agganciando un'applicazione di autenticazione generativa (OTP).</p>
            <div class="header-line-left"></div>
        </div>

        <partial name="_StatusMessage" for="StatusMessage" />

        <div class="stepper-2fa-container mt-4">
            <ol class="stepper-list p-0">
                <li class="step-item mb-4">
                    <h5 class="step-title">// FASE 1: APPLICAZIONE</h5>
                    <p class="step-desc text-muted">
                        Scarica un'app di autenticazione a due fattori come Microsoft Authenticator per
                        <a href="https://go.microsoft.com/fwlink/?Linkid=825072" target="_blank" class="step-link">Android</a> /
                        <a href="https://go.microsoft.com/fwlink/?Linkid=825073" target="_blank" class="step-link">iOS</a>
                        oppure Google Authenticator per
                        <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2" target="_blank" class="step-link">Android</a> /
                        <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605" target="_blank" class="step-link">iOS</a>.
                    </p>
                </li>

                <li class="step-item mb-4">
                    <h5 class="step-title">// FASE 2: ACQUISIZIONE</h5>
                    <p class="step-desc text-muted">Scansiona il codice grafico sottostante o inserisci manualmente la seguente chiave alfanumerica nell'applicazione:</p>

                    <div class="key-display-box my-3">
                        <kbd class="custom-kbd">@Model.SharedKey</kbd>
                    </div>

                    <div class="qr-wrapper d-flex justify-content-center align-items-center my-4">
                        <div id="canvas" class="qr-canvas-frame"></div>
                    </div>
                </li>

                <li class="step-item">
                    <h5 class="step-title">// FASE 3: VERIFICA</h5>
                    <p class="step-desc text-muted">L'applicazione genererà un codice temporaneo unico. Inseriscilo qui sotto per validare il collegamento:</p>

                    <form id="send-code" method="post" class="manage-form mt-3">
                        <div asp-validation-summary="ModelOnly" class="auth-error-summary mb-3" role="alert"></div>

                        <div class="input-group-custom mb-3">
                            <label asp-for="Input.Code" class="form-label-custom">Codice di Verifica Ricevuto</label>
                            <input asp-for="Input.Code" class="form-control-custom text-center font-monospace" autocomplete="off" placeholder="000 000" inputmode="numeric" />
                            <span asp-validation-for="Input.Code" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <button type="submit" class="btn-auth-submit px-5 w-auto">Attiva Protezione</button>
                    </form>
                </li>
            </ol>
        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script type="text/javascript" src="https://unpkg.com/qr-code-styling@1.5.0/lib/qr-code-styling.js"></script>
    <script type="text/javascript">
        const uriValue = "@Html.Raw(Model.AuthenticatorUri)";

        const qrCode = new QRCodeStyling({
            width: 260,
            height: 260,
            type: "svg",
            data: uriValue,
            image: "/img/VanitasLogo.png",
            dotsOptions: {
                color: "#c5a880", // L'oro di Vanitas al posto del blu di facebook
                type: "dots"      // Stile a punti circolari, molto elegante
            },
            backgroundOptions: {
                color: "rgba(20, 20, 24, 0.6)", // Sfondo scuro e semitrasparente integrato con la UI
            },
            imageOptions: {
                crossOrigin: "anonymous",
                margin: 10
            },
            cornersSquareOptions: {
                color: "#fff",          // I quadrati esterni di tracciamento diventano bianchi puri
                type: "extra-rounded"
            },
            cornersDotOptions: {
                color: "#c5a880"         // I punti interni dei quadrati di tracciamento diventano oro
            }
        });

        qrCode.append(document.getElementById("canvas"));
    </script>
}