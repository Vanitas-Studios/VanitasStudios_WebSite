@page
@model LoginModel

@{
    ViewData["Title"] = "Inizia Sessione";
    Layout = "/Pages/Shared/_Layout.cshtml"; // Forza l'uso del layout globale di Vanitas
}

<div class="auth-container">
    <div class="auth-box">
        <div class="auth-header text-center">
            <span class="auth-brand">// VANITAS STUDIOS</span>
            <h1 class="auth-title">Inizia la Sessione</h1>
            <p class="auth-subtitle">Accedi per gestire i frammenti, le analisi e le strutture narrative del portale.</p>
        </div>

        <form id="account" method="post" class="auth-form mt-4">
            <div asp-validation-summary="ModelOnly" class="auth-error-summary mb-3" role="alert"></div>

            <div class="input-group-custom mb-3">
                <label asp-for="Input.UserNameorEmail" class="form-label-custom">Nome Utente o Email</label>
                <input asp-for="Input.UserNameorEmail" class="form-control-custom" autocomplete="username" aria-required="true" placeholder="operatore@vanitas o username" />
                <span asp-validation-for="Input.UserNameorEmail" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="input-group-custom mb-3">
                <label asp-for="Input.Password" class="form-label-custom">Chiave di Accesso (Password)</label>
                <input asp-for="Input.Password" class="form-control-custom" autocomplete="current-password" aria-required="true" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="auth-utility d-flex justify-content-between align-items-center mb-4">
                <label asp-for="Input.RememberMe" class="checkbox-custom d-flex align-items-center gap-2">
                    <input class="form-check-input custom-check" asp-for="Input.RememberMe" />
                    <span class="checkbox-text">Mantieni la sessione</span>
                </label>
                <a id="forgot-password" asp-page="./ForgotPassword" class="auth-link-secondary">Smarrito la chiave?</a>
            </div>

            <button id="login-submit" type="submit" class="btn-auth-submit w-100">
                Invia Credenziali
            </button>

            <div class="auth-footer-links text-center mt-4">
                <p class="mb-1">
                    <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="auth-link-muted">
                        Non hai ricevuto la mail di conferma?
                    </a>
                </p>
                @* <p class="m-0"><a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="auth-link-muted">Crea un nuovo account</a></p> *@
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}