@page
@model RegisterModel
@{
    ViewData["Title"] = "Inizia Percorso";
    Layout = "/Pages/Shared/_Layout.cshtml"; // Forza il layout globale di Vanitas
}

<div class="auth-container">
    <div class="auth-box">
        <div class="auth-header text-center">
            <span class="auth-brand">// VANITAS STUDIOS</span>
            <h1 class="auth-title">Crea Account</h1>
            <p class="auth-subtitle">Registra una nuova identità per accedere ai servizi e ai frammenti del portale.</p>
        </div>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="auth-form mt-4">
            <div asp-validation-summary="ModelOnly" class="auth-error-summary mb-3" role="alert"></div>

            <div class="input-group-custom mb-3">
                <label asp-for="Input.UserName" class="form-label-custom">Nome Utente (Identificativo)</label>
                <input asp-for="Input.UserName" class="form-control-custom" autocomplete="username" aria-required="true" placeholder="es. Operatore01" />
                <span asp-validation-for="Input.UserName" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="input-group-custom mb-3">
                <label asp-for="Input.Email" class="form-label-custom">Indirizzo Email</label>
                <input asp-for="Input.Email" class="form-control-custom" autocomplete="email" aria-required="true" placeholder="nome@esempio.com" />
                <span asp-validation-for="Input.Email" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="input-group-custom mb-3">
                <label asp-for="Input.Password" class="form-label-custom">Chiave di Accesso (Password)</label>
                <input asp-for="Input.Password" class="form-control-custom" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="input-group-custom mb-4">
                <label asp-for="Input.ConfirmPassword" class="form-label-custom">Conferma Chiave di Accesso</label>
                <input asp-for="Input.ConfirmPassword" class="form-control-custom" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small mt-1 d-block"></span>
            </div>

            <button id="registerSubmit" type="submit" class="btn-auth-submit w-100">
                Genera Identità
            </button>

            <div class="auth-footer-links text-center mt-4">
                <p class="m-0">
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="auth-link-secondary small">
                        Hai già un account operativo? <span class="text-white font-weight-bold">Accedi qui</span>
                    </a>
                </p>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}