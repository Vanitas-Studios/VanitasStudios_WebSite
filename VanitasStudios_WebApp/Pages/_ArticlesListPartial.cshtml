@{
}

@model VanitasStudios_WebApp.Models.ArticlesManagementViewModel;
@using VanitasStudios_WebApp.Models
@using System.Text.Encodings.Web

<div class="animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold m-0">Gestione Contenuti</h2>
            <p class="text-muted small m-0">Modifica, pubblica o rimuovi gli articoli all'interno del database.</p>
        </div>
        <!-- Pulsante rapido per creare un nuovo articolo da zero -->
        <a asp-page="/Admin/Editor" class="btn btn-dark btn-sm px-3">
            <i class="bi bi-plus-lg me-1"></i> Nuovo Articolo
        </a>
    </div>

    <div class="card border-0 bg-light p-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle m-0">
                <thead>
                    <tr class="text-muted small text-uppercase font-monospace border-bottom">
                        <th style="width: 40%;">Titolo</th>
                        <th style="width: 15%;">Categoria</th>
                        <th style="width: 15%;">Stato</th>
                        <th style="width: 15%;">Ultima Modifica</th>
                        <th style="width: 15%;" class="text-end">Azioni</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Articles.Any())
                    {
                        foreach (var article in Model.Articles)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark text-truncate" style="max-width: 350px;">
                                        @article.Title
                                    </div>
                                    <span class="text-muted x-small" style="font-size: 0.75rem;">ID: #@article.Id</span>
                                </td>
                                <td>
                                    @if (article.Category == "Senza Tag")
                                    {
                                        <span class="badge bg-light text-muted border font-monospace">@article.Category</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary opacity-75 font-monospace">@article.Category</span>
                                    }
                                </td>
                                <td>
                                    @if (article.PublishState == PublishState.Pubblico)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1">Online</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2.5 py-1">Bozza</span>
                                    }
                                </td>
                                <td class="text-muted small">
                                    @(article.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? article.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "N/D")
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <!-- CTA Modifica: Rimanda alla pagina dell'editor passando l'ID dell'articolo -->
                                        <a asp-page="/Admin/Editor" asp-route-id="@article.Id" class="btn btn-sm btn-outline-dark" title="Modifica articolo">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <!-- CTA Elimina: Innesca una funzione JS passando l'ID per gestire la modale di conferma o la chiamata AJAX -->
                                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteArticle(@article.Id, '@JavaScriptEncoder.Default.Encode(article.Title)')" title="Elimina articolo">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">
                                <i class="bi bi-journal-text fs-2 d-block mb-2"></i>
                                <p class="m-0">Nessun articolo trovato nel database. Comincia creandone uno nuovo!</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>