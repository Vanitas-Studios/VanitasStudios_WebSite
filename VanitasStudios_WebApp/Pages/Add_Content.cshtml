@page
@model VanitasStudios_WebApp.Pages.Add_ContentModel
@{
    ViewData["Title"] = "Home page";
}
@Html.AntiForgeryToken();


<input type="hidden" id="ArticleId" value="@Model.ArticleId" />
<section id="editor-page" class="container-xl p-3 px-4 d-flex flex-column" style="min-height: calc(100vh - 60px);">

    <div class="row py-2">
        <div class="col">
            <input type="text" class="form-control form-control-lg" placeholder="Title" />
        </div>
    </div>

    <div id="save-status-container" class="d-flex align-items-center mb-2" style="font-size: 0.85rem; color: #666;">
        <span id="save-status-dot" class="status-dot me-2"></span>
        <span id="save-status-text">Tutte le modifiche salvate</span>
    </div>

    <div class="row flex-grow-1 overflow-hidden">

        <div class="col-10 d-flex flex-column">
            <div id="editor" contenteditable="true" class="form-control h-100 overflow-auto">

                @if (Model.CurrentContent?.Sections != null && Model.CurrentContent.Sections.Any())
                {
                    @foreach (var sezione in Model.CurrentContent.Sections.OrderBy(s => s.Order))
                    {
                        <div class="editor-section mb-3" data-section-id="@sezione.Id">

                            <span class="badge bg-primary me-1 section-title-badge" contenteditable="false">
                                @(sezione.Title ?? "Sezione senza titolo")
                            </span>

                            <div class="section-content" contenteditable="true">
                                @Html.Raw(sezione.HtmlText ?? "<br>")
                            </div>

                        </div>
                    }
                }
                else
                {
                    <br>
                }

            </div>
        </div>

        <div class="col-2 border-start">
            <h5>Vanitas Structure</h5>
            <ul id="editor-structure" class="list-unstyled">
            </ul>
        </div>
    </div>

   @*  <div class="row py-3">
        <div class="col">
            <input type="text" class="form-control mb-2" placeholder="Search tag" />
            <div class="d-flex flex-wrap gap-1">
                @foreach (var tag in Model.Tags)
                {
                    <span class="badge bg-secondary">@tag.Name</span>
                }
            </div>
        </div>
    </div> *@

    <button type="button" class="btn btn-primary" onclick="contentPreview()">
        Preview
    </button>

    <div class="modal fade" id="DocumentPreview" tabindex="-1" aria-labelledby="Article" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="Article">Anteprima Articolo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="sectionsBodyContent" style="height: 75vh; padding: 0;">
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/editor_logic_mastery.js" asp-append-version="true"></script>

    <script>

        document.addEventListener("DOMContentLoaded", function() {
            initMyEditor({
                editorId: 'editor',
                sidebarId: 'editor-structure',
                articleId: '@Model.ArticleId',
                lastModified: '@Model.LastModified.ToString("yyyy-MM-ddTHH:mm:ss")'
            });
        });
    </script>
}