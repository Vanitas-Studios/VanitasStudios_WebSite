@page
@using VanitasStudios_WebApp.Models
@model VanitasStudios_WebApp.Pages.Add_ContentModel
@{
    ViewData["Title"] = "Home page";
}
@Html.AntiForgeryToken();


<input type="hidden" id="ArticleId" value="@Model.ArticleId" />
<section id="editor-page" class="container-xl p-3 px-4 d-flex flex-column" style="min-height: calc(100vh - 60px);">

    <div class="row py-2">
        <div class="col">
            <input type="text" class="form-control form-control-lg" placeholder="Title" />
        </div>
    </div>

    <div id="save-status-container" class="d-flex align-items-center mb-2" style="font-size: 0.85rem; color: #666;">
        <span id="save-status-dot" class="status-dot me-2"></span>
        <span id="save-status-text">Tutte le modifiche salvate</span>
    </div>

    <div class="row flex-grow-1 overflow-hidden">

        <div class="col-10 d-flex flex-column">
            <div id="editor" contenteditable="true" class="form-control h-100 overflow-auto">

                @if (Model.CurrentContent?.Sections != null && Model.CurrentContent.Sections.Any())
                {
                    @foreach (var sezione in Model.CurrentContent.Sections.OrderBy(s => s.Order))
                    {
                        <div class="editor-section mb-3" data-section-id="@sezione.Id">

                            <span class="badge bg-primary me-1 section-title-badge" contenteditable="false">
                                @(sezione.Title ?? "Sezione senza titolo")
                            </span>

                            <div class="section-content" contenteditable="true">
                                @Html.Raw(sezione.HtmlText ?? "<br>")
                            </div>

                        </div>
                    }
                }
                else
                {
                    <br>
                }

            </div>
        </div>

        <div class="col-2 border-start">
            <h5>Vanitas Structure</h5>
            <ul id="editor-structure" class="list-unstyled">
            </ul>

            <div class="border rounded p-2 mb-3 text-center bg-light" style="font-size: 0.9rem;">
                <h6 class="mb-2 fw-bold text-start text-uppercase text-muted" style="font-size: 0.75rem;">Copertina</h6>

                <img id="coverPreview" src="@Model.CurrentContent?.CoverImageUrl"
                     alt="Preview" class="img-fluid rounded mb-2 shadow-sm"
                     style="max-height: 120px; object-fit: cover; display: @(string.IsNullOrEmpty(Model.CurrentContent?.CoverImageUrl) ? "none" : "block"); width: 100%;" />

                <div id="coverPlaceholder" class="py-3 border border-dashed rounded mb-2 text-muted"
                     style="display: @(string.IsNullOrEmpty(Model.CurrentContent?.CoverImageUrl) ? "block" : "none");">
                    <i class="bi bi-image" style="font-size: 1.5rem;"></i>
                    <p class="m-0" style="font-size: 0.75rem;">Nessuna immagine</p>
                </div>

                <input type="file" id="coverFileInput" accept="image/*" class="d-none" onchange="uploadArticleCover()" />
                <button type="button" class="btn btn-sm btn-dark w-100" onclick="document.getElementById('coverFileInput').click()">
                    <i class="bi bi-upload"></i> Carica
                </button>
            </div>

        </div>
    </div>

    <button type="button" class="btn btn-primary" onclick="contentPreview()">
        Preview
    </button>

    <div class="modal fade" id="DocumentPreview" tabindex="-1" aria-labelledby="Article" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="Article">Anteprima Articolo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="sectionsBodyContent" style="height: 75vh; padding: 0;">
                </div>
            </div>
        </div>
    </div>


    <div class="row py-3 border-top mt-4">
        <div class="col-12">
            <label class="fw-bold text-uppercase text-muted small d-block mb-2">Tag Articolo</label>

            <div id="selected-tags-container" class="d-flex flex-wrap gap-2 mb-2">
                @if (Model.CurrentContent?.ContentTags != null)
                {
                    foreach (var ct in Model.CurrentContent.ContentTags)
                    {
                        <span class="badge bg-secondary d-flex align-items-center gap-1 p-2" data-tag-id="@ct.TagId">
                            @ct.Tag.Name
                            <span style="cursor: pointer;" class="ms-1 fw-bold" onclick="removeTagBlock(this, @ct.TagId)">&#x2715;</span>
                        </span>
                    }
                }
            </div>

            <div class="position-relative style-tags-search" style="max-width: 400px;">
                <input type="text" id="tagSearchInput" class="form-control form-control-sm" placeholder="Scrivi per cercare un tag..." autocomplete="off" />

                <ul id="tagSuggestionsMenu" class="dropdown-menu w-100 shadow-sm position-absolute" style="display: none; max-height: 200px; overflow-y: auto; z-index: 1050;">
                </ul>
            </div>
        </div>
    </div>

    <div class="publish-zone p-3 border rounded bg-light mb-3">
        <h6 class="fw-bold">Stato Contenuto</h6>
        <div class="d-flex align-items-center gap-2 mb-3">
            @if (Model.CurrentContent.PublishState == PublishState.Pubblico)
            {
                <span class="badge bg-success">Pubblicato il @Model.CurrentContent.UpdatedAt?.ToString("dd/MM/yyyy")</span>
            }
            else
            {
                <span class="badge bg-warning text-dark">Bozza (Autosalvato)</span>
            }
        </div>

        @if (Model.CurrentContent.PublishState == PublishState.Bozza)
        {
            <button type="button" class="btn btn-primary w-100" onclick="changeContentStatus('Publish')">
                Metti Online
            </button>
        }
        else
        {
            <div class="d-flex flex-column gap-2">
                <button type="button" class="btn btn-success w-100" onclick="changeContentStatus('Update')">
                    Aggiorna Articolo
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm w-100" onclick="changeContentStatus('ToDraft')">
                    Riporta a Bozza (Nascondi)
                </button>
            </div>
        }
    </div>


</section>

@section Scripts {
    <script src="~/js/editor_logic_mastery.js" asp-append-version="true"></script>

    <script>

        document.addEventListener("DOMContentLoaded", function() {
            initMyEditor({
                editorId: 'editor',
                sidebarId: 'editor-structure',
                articleId: '@Model.ArticleId',
                lastModified: '@Model.LastModified.ToString("yyyy-MM-ddTHH:mm:ss")',
                tagInput: 'tagSearchInput',
                suggestionsMenu: 'tagSuggestionsMenu',
                tagsContainer: 'selected-tags-container'
            });
        });
    </script>
}