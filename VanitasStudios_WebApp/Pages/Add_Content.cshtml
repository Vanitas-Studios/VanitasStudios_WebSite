@page
@model VanitasStudios_WebApp.Pages.Add_ContentModel
@{
    ViewData["Title"] = "Home page";
}
@Html.AntiForgeryToken();


<input type="hidden" id="ArticleId" value="@Model.ArticleId" />
<section id="editor-page" class="container vh-100 d-flex flex-column">

    <div class="row py-2">
        <div class="col">
            <input type="text" class="form-control form-control-lg" placeholder="Title" />
        </div>
    </div>

    <div id="save-status-container" class="d-flex align-items-center mb-2" style="font-size: 0.85rem; color: #666;">
        <span id="save-status-dot" class="status-dot me-2"></span>
        <span id="save-status-text">Tutte le modifiche salvate</span>
    </div>

    <div class="row flex-grow-1 overflow-hidden">

        <div class="col-10 d-flex flex-column">
            <div id="editor" contenteditable="true" class="form-control h-100 overflow-auto">
            </div>
        </div>

        <div class="col-2 border-start">
            <h5>Vanitas Structure</h5>
            <ul id="editor-structure" class="list-unstyled">
            </ul>
        </div>
    </div>

   @*  <div class="row py-3">
        <div class="col">
            <input type="text" class="form-control mb-2" placeholder="Search tag" />
            <div class="d-flex flex-wrap gap-1">
                @foreach (var tag in Model.Tags)
                {
                    <span class="badge bg-secondary">@tag.Name</span>
                }
            </div>
        </div>
    </div> *@
</section>

@section Scripts {
    <script src="~/js/editor_logic_mastery.js" asp-append-version="true"></script>

    <script>

        document.addEventListener("DOMContentLoaded", function() {
            initMyEditor({
                editorId: 'editor',
                sidebarId: 'editor-structure',
                articleId: '@Model.ArticleId',
                lastModified: '@Model.LastModified.ToString("yyyy-MM-ddTHH:mm:ss")'
            });
        });
    </script>
}