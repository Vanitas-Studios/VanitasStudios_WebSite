@page
@model VanitasStudios_WebApp.Pages.Add_ContentModel
@{
}


<section class="editor-container">
   <form method="post">

        <!-- <select id="content-type-select" asp-for="ContentType" class="form-select bg-dark text-light border-secondary" aria-label="Select the type of content">
                    <option selected>Choose type document</option>
                    <option value="Doc">Documentation</option>
                    <option value="Blog">Article</option>
             </select>-->

        <input type="text" id="article-title" asp-for="@Model.Section.Title" placeholder="Titolo dell'opera..." />

        <div class="editor-wrapper" style="display: flex; gap: 20px; position: relative;">
            <textarea id="markdown-editor" name="Content" asp-for="@Model.Section.Content" style="flex-grow: 1; height: 500px; font-family: monospace;"></textarea>

            <div id="drop-overlay" class="drop-zone-overlay">
                <div class="overlay-content">
                    <i class="fas fa-cloud-upload-alt"></i>
                    <p>Rilascia il file per caricarlo nel documento</p>
                </div>
            </div>

            <aside id="section-checklist" style="width: 200px;">
                <h4>Struttura Vanitas</h4>
                <ul id="checklist-items">
                </ul>
                <h4>Media Allegati</h4>
                <ul id="media-list" class="media-management-list">
                </ul>
            </aside>
        </div>
        <div class="tags-mvp-container mt-4 p-3 border border-secondary rounded bg-dark">
            <label class="text-secondary small d-block mb-2 text-uppercase fw-bold">Associa Tag al Contenuto</label>

            <div id="tag-area" class="mt-4">
                <label>Tag disponibili:</label>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var tag in Model.AvailableTags)
                    {
                        <span class="badge border border-secondary p-2 tag-item" data-id="@tag.IdT">
                            #@tag.TagName
                        </span>
                    }
                </div>
            </div>
        </div>
        <div class="editor-actions">
            <button type="submit" name="publish" value="false" class="btn-secondary">
                Salva Bozza
            </button>

            <button type="submit" name="publish" value="true" class="btn-primary" asp-page-handler="SaveContent">
                Pubblica
            </button>
        </div>
   </form>
</section>

@section Scripts {
    <script>
        // 1. VARIABILI GLOBALI
        let editor, checklist, typeSelect, form;
        let haIntro = false;
        let haConcl = false;

        // 2. FUNZIONI DI UTILITÀ
        function updateChecklist() {
            if (!editor || !checklist) return;
            const testo = editor.value;
            haIntro = false;
            haConcl = false;
            let nomeIntroTrovato = "Introduzione";
            let nomeConcluTrovata = "Conclusione";
            const sezioniExtra = [];
            const righe = testo.split('\n');

            righe.forEach(riga => {
                if (riga.startsWith('##')) {
                    const titolo = riga.replace('##', '').trim();
                    if (titolo.startsWith("Introduzione")) { haIntro = true; nomeIntroTrovato = titolo; }
                    else if (titolo.startsWith("Conclusione")) { haConcl = true; nomeConcluTrovata = titolo; }
                    else if (titolo !== "") { sezioniExtra.push(titolo); }
                }
            });

            checklist.innerHTML = "";
            renderItem(nomeIntroTrovato, haIntro, true);
            sezioniExtra.forEach(s => renderItem(s, true, false));
            renderItem(nomeConcluTrovata, haConcl, true);
        }

        function renderItem(nome, presente, isPilastro) {
            const li = document.createElement('li');
            li.textContent = (isPilastro ? (presente ? "✓ " : "✗ ") : "• ") + nome;
            li.style.color = isPilastro ? (presente ? "#4caf50" : "#ff5252") : "#bbb";
            if (isPilastro) li.style.fontWeight = "bold";
            checklist.appendChild(li);
        }

        function autoSave() {
            if (!editor) return;
            const data = {
                title: document.getElementById("article-title").value,
                content: editor.value,
                type: typeSelect.value
            };
            localStorage.setItem("vanitas_draft", JSON.stringify(data));
        }

        function rebuildMediaList(text) {
            const mediaList = document.getElementById("media-list");
            if (!mediaList) return;
            mediaList.innerHTML = "";
            const regex = /\[(img|video);\s*src="([^"]+)",\s*alt="([^"]+)"[^\]]*\]/g;
            let match;
            while ((match = regex.exec(text)) !== null) {
                const li = document.createElement("li");
                li.innerHTML = `<span>${match[3]}</span><button type="button" onclick="deleteMedia('${match[2]}', this)" class="btn-delete-small">×</button>`;
                mediaList.appendChild(li);
            }
        }

        async function deleteMedia(fileUrl, buttonElement) {
            if (!confirm("Eliminare definitivamente il file?")) return;
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const response = await fetch(`?handler=DeleteMedia&fileUrl=${encodeURIComponent(fileUrl)}`, {
                method: 'POST',
                headers: { "RequestVerificationToken": token }
            });
            if (response.ok) {
                buttonElement.parentElement.remove();
                const escapedUrl = fileUrl.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                editor.value = editor.value.replace(new RegExp(`\n?\\[(img|video);\\s*src="${escapedUrl}".*?\\]\n?`, "g"), "");
                updateChecklist();
                autoSave();
            }
        }

        // 3. INIZIALIZZAZIONE DOM
        document.addEventListener('DOMContentLoaded', () => {
            editor = document.getElementById("markdown-editor");
            checklist = document.getElementById("checklist-items");
            typeSelect = document.getElementById("content-type-select");
            form = document.querySelector('form');
            const wrapper = document.querySelector('.editor-wrapper');
            const overlay = document.getElementById('drop-overlay');

            const defaultTemplate = "##Introduzione: [Titolo]\n\n[Testo]\n\n##Conclusione: [Titolo]\n\n[Fine]";
            const savedData = localStorage.getItem("vanitas_draft");

            // Ripristino o Template
            if (savedData) {
                const data = JSON.parse(savedData);
                if (confirm("📋 Ripristinare la bozza non salvata?")) {
                    document.getElementById("article-title").value = data.title;
                    editor.value = data.content;
                    typeSelect.value = data.type;
                    if (data.type !== "") typeSelect.disabled = true;
                } else {
                    localStorage.removeItem("vanitas_draft");
                    editor.value = defaultTemplate;
                }
            } else if (editor.value.trim() === "") {
                editor.value = defaultTemplate;
            }

            updateChecklist();
            rebuildMediaList(editor.value);

            // Listeners base
            editor.addEventListener("input", () => { updateChecklist(); autoSave(); });
            document.getElementById("article-title").addEventListener("input", autoSave);
            typeSelect.addEventListener("change", autoSave);

            // 4. LOGICA DROP (Spostata qui dentro per usare le variabili locali)
            wrapper.addEventListener('dragenter', (e) => { e.preventDefault(); overlay.classList.add('active'); });
            overlay.addEventListener('dragover', (e) => { e.preventDefault(); });
            overlay.addEventListener('dragleave', (e) => { overlay.classList.remove('active'); });

            overlay.addEventListener('drop', async (e) => {
                e.preventDefault();
                overlay.classList.remove('active');

                //if (!typeSelect.value || typeSelect.value === "") {
                    //alert("⚠️ Seleziona prima il Type Document!");
                    //typeSelect.focus();
                    //return;
                //}

                const file = e.dataTransfer.files[0];
                if (!file) return;

                const formData = new FormData();
                formData.append("file", file);
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                try {
                    const response = await fetch(`?handler=UploadMedia`, {
                        method: 'POST',
                        headers: { "RequestVerificationToken": token },
                        body: formData
                    });

                    if (response.ok) {
                        const data = await response.json();
                        const tag = `\n\n[${file.type.startsWith("video/") ? 'video' : 'img'}; src="${data.url}", alt="${data.alt}", type="${data.extension}"]\n\n`;

                        const start = editor.selectionStart;
                        editor.value = editor.value.substring(0, start) + tag + editor.value.substring(editor.selectionEnd);

                        typeSelect.disabled = true;
                        rebuildMediaList(editor.value);
                        updateChecklist();
                        autoSave();
                        editor.focus();
                    }
                } catch (err) { console.error(err); }
            });

            form.addEventListener('submit', (e) => {
                if (e.submitter?.value === "true" && (!haIntro || !haConcl)) {
                    e.preventDefault();
                    alert("⚠️ Struttura incompleta!");
                    return;
                }
                localStorage.removeItem("vanitas_draft");
            });
        });
    </script>
}