@{
}

@model List<VanitasStudios_WebApp.Models.AdminLog>

<div class="animate-fade-in">
    <div class="mb-4">
        <h2 class="fw-bold m-0">Registro di Controllo</h2>
        <p class="text-muted small m-0">Storico delle ultime 100 azioni di sicurezza e modifiche strutturali eseguite dagli amministratori.</p>
    </div>

    <div class="card border-0 bg-light p-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle m-0" aria-label="Registro delle azioni amministrative">
                <thead>
                    <tr class="text-muted small text-uppercase font-monospace border-bottom">
                        <th style="width: 20%;">Operatore</th>
                        <th style="width: 15%;">Azione</th>
                        <th style="width: 40%;">Descrizione</th>
                        <th style="width: 15%;">Data</th>
                        <th style="width: 10%;" class="text-end">Indirizzo IP</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var log in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@@@log.User.UserName</div>
                                    <span class="text-muted font-monospace x-small" style="font-size: 0.7rem;">UID: #@log.UserId</span>
                                </td>
                                <td>
                                    @switch (log.ActionType)
                                    {
                                        case "TOGGLE_PIN":
                                            <span class="badge bg-warning text-dark font-monospace text-uppercase" style="font-size: 0.7rem;">@log.ActionType</span>
                                            break;
                                        case "DELETE_ARTICLE":
                                            <span class="badge bg-danger-subtle text-danger font-monospace text-uppercase" style="font-size: 0.7rem;">@log.ActionType</span>
                                            break;
                                        case "UPDATE_ARTICLE_GLOBAL":
                                            <span class="badge bg-dark text-white font-monospace text-uppercase" style="font-size: 0.7rem;">@log.ActionType</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary font-monospace text-uppercase" style="font-size: 0.7rem;">@log.ActionType</span>
                                            break;
                                    }
                                </td>
                                <td class="text-secondary small">
                                    @log.Description
                                </td>
                                <td class="text-muted small">
                                    @log.ExecutedAt.ToString("dd/MM/yyyy HH:mm:ss")
                                </td>
                                <td class="text-end font-monospace text-muted small">
                                    @(string.IsNullOrEmpty(log.IpAddress) ? "0.0.0.0" : log.IpAddress)
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">
                                <i class="bi bi-shield-check fs-2 d-block mb-2"></i>
                                <p class="m-0">Il registro è attualmente vuoto. Nessuna operazione tracciata.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>