@{
}
@model VanitasStudios_WebApp.Pages.TagsManagementViewModel

<div class="animate-fade-in">
    <div class="mb-4">
        <h2 class="fw-bold m-0">Tassonomia e Vocabolario IA</h2>
        <p class="text-muted small m-0">Gestisci i Tag del portale, assegna i Gruppi Categoria e addestra i Sinonimi per l'Akinator.</p>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 bg-light p-3 mb-3">
                <h6 class="fw-bold text-uppercase small text-muted mb-3">Crea Nuovo Tag</h6>
                <form method="post" onsubmit="submitTagForm(event, 'CreateTag')">
                    <div class="mb-2">
                        <label class="form-label small fw-bold text-secondary mb-1">Nome Tag</label>
                        <input type="text" name="TagName" class="form-control form-control-sm" placeholder="es. Grimdark, C#, Calisthenics" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary mb-1">Gruppo Categoria</label>
                        <input type="text" name="CategoryGroup" class="form-control form-control-sm" placeholder="es. Gaming, Programmazione, Sport" />
                    </div>
                    <button type="submit" class="btn btn-dark btn-sm w-100">
                        <i class="bi bi-plus-circle me-1"></i> Salva Tag
                    </button>
                </form>
            </div>

            <div class="card border-0 bg-light p-3">
                <h6 class="fw-bold text-uppercase small text-muted mb-3">Aggiungi Sinonimo</h6>
                <form onsubmit="submitTagForm(event, 'CreateSynonym')">
                    <div class="mb-2">
                        <label class="form-label small fw-bold text-secondary mb-1">Seleziona Tag Principale</label>
                        <select name="TargetTagId" class="form-select form-select-sm" required>
                            <option value="">-- Scegli un tag --</option>
                            @foreach (var tag in Model.AvailableTags)
                            {
                                <option value="@tag.Id">#@tag.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary mb-1">Parola Sinonimo (User Input)</label>
                        <input type="text" name="SynonymWord" class="form-control form-control-sm" placeholder="es. GDR (per Role-Playing Game)" required />
                    </div>
                    <button type="submit" class="btn btn-outline-dark btn-sm w-100">
                        <i class="bi bi-shuffle me-1"></i> Collega Sinonimo
                    </button>
                </form>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 bg-light p-3 h-100">
                <h6 class="fw-bold text-uppercase small text-muted mb-3">Dizionario dei Tag Attivi</h6>
                <div class="table-responsive">
                    <table class="table table-hover align-middle m-0 bg-white rounded shadow-sm">
                        <thead>
                            <tr class="text-muted small text-uppercase font-monospace border-bottom">
                                <th style="width: 30%;">Tag</th>
                                <th style="width: 25%;">Categoria</th>
                                <th style="width: 35%;">Sinonimi Collegati</th>
                                <th style="width: 10%;" class="text-end">Azioni</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.TagsList.Any())
                            {
                                foreach (var tag in Model.TagsList)
                                {
                                    <tr>
                                        <td>
                                            <span class="fw-bold text-dark">#@tag.Name</span>
                                            <span class="d-block text-muted x-small">ID: @tag.Id</span>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(tag.CategoryGroup))
                                            {
                                                <span class="badge bg-dark text-white font-monospace">@tag.CategoryGroup</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border font-monospace">Nessuna</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex flex-wrap gap-1">
                                                @if (tag.Synonyms.Any())
                                                {
                                                    foreach (var syn in tag.Synonyms)
                                                    {
                                                        <span class="badge bg-light text-secondary border font-monospace x-small" style="font-size: 0.75rem;">
                                                            @syn
                                                        </span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted small fst-italic">Nessuno</span>
                                                }
                                            </div>
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteTag(@tag.Id)" title="Elimina Tag">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-5">
                                        <i class="bi bi-tags fs-2 d-block mb-2"></i>
                                        <p class="m-0">Nessun tag censito nel sistema.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>