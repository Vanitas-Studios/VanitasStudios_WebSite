@using Microsoft.AspNetCore.Identity
@using VanitasStudios_WebApp.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center gap-3">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle btn-profile-dropdown" href="#" id="userNavbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <span class="profile-marker">//</span> @(User.Identity?.Name ?? "Sessione Attiva")
            </a>

            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end auth-dropdown-box" aria-labelledby="userNavbarDropdown">
                @if (User.IsInRole("Admin") || User.IsInRole("Editor"))
                {
                    <li>
                        <a class="dropdown-item py-2" asp-page="/Add_Content">
                            <i class="bi bi-plus-square me-2 text-muted"></i>Scrivi Frammento
                        </a>
                    </li>
                    <li><hr class="dropdown-divider opacity-10"></li>
                }

                <li>
                    <a class="dropdown-item py-2" asp-area="Identity" asp-page="/Account/Manage/Index">
                        <i class="bi bi-gear me-2 text-muted"></i>Impostazioni Account
                    </a>
                </li>

                <li><hr class="dropdown-divider opacity-10"></li>

                <li>
                    <form class="form-inline m-0 p-0" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" method="post">
                        <button type="submit" class="dropdown-item text-danger py-2 w-100 text-start backend-logout-btn">
                            <i class="bi bi-box-arrow-right me-2"></i>Scollegati
                        </button>
                    </form>
                </li>
            </ul>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link btn-login-nav text-uppercase" asp-area="Identity" asp-page="/Account/Login">
                // ACCEDI
            </a>
        </li>
    }
</ul>