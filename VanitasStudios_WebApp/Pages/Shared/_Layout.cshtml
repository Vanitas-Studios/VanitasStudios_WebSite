<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VanitasStudios_WebApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VanitasStudios_WebApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-transparent box-shadow" id="Nav-menu">
            <div class="container d-flex align-items-center">

                <div class="flex-1 d-flex justify-content-start" style="flex: 1;">
                    <a class="navbar-brand" asp-area="" asp-page="/Index">
                        <img src="/img/Logo.png" width="60" height="70" alt="Logo" decoding="async" fetchpriority="high" />
                    </a>
                </div>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-center" id="navbarContent" style="flex: 2;">
                    <ul class="navbar-nav menu-links gap-5">
                        <li class="nav-item"><a class="nav-link text-white text-uppercase px-3" asp-page="/Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link text-white text-uppercase px-3" asp-page="/GameDoc">Game</a></li>
                        <li class="nav-item"><a class="nav-link text-white text-uppercase px-3" asp-page="/Blog">Blog</a></li>
                        @if(User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link text-white text-uppercase px-3" asp-page="/AdminInterface">Admin</a></li>
                        }
                        @if (User.Identity.IsAuthenticated && (User.IsInRole("Editor") || User.IsInRole("Admin")))
                        {
                            <li class="nav-item"><a class="nav-link text-white text-uppercase px-3" asp-page="/Add_Content">Write</a></li>
                        }
                    </ul>
                </div>

                <div class="d-none d-sm-flex justify-content-end" style="flex: 1;">
                    <partial name="_LoginPartial" />
                </div>

            </div>
        </nav>
    </header>
    <main role="main" class="">
        @RenderBody()
    </main>

    <footer class="border-top border-dark footer text-muted bg-black">
        <div class="container d-flex justify-content-between align-items-center">

            <div class="footer-text">
                &copy; 2026 - Vanitas Studios - All rights reserved
                <a asp-area="" asp-page="/Privacy" class="ms-2 text-decoration-none">Privacy</a>
            </div>

            <div class="footer-links d-flex gap-3">
                <a href="https://www.instagram.com/vanitas_studios_official?igsh=aWQxNmg5cTEyMXFr" target="_blank" class="text-decoration-none text-light">Instagram</a>
                <a href="https://youtube.com/@@vanitasstudioshub?si=w9BQlbcNE1F63szm" target="_blank" class="text-decoration-none text-light">YouTube</a>
                <a href="#" target="_blank" class="text-decoration-none text-light">GitHub</a>
            </div>

        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>